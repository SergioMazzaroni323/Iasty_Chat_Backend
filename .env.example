DATABASE_URL=sqlite:///./chatbot.db
SECRET_KEY=change-me-to-a-long-random-string
OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
# Use openrouter for GPT if OpenAI blocks your server IP (VPS/cloud)
GPT_PROVIDER=openai
SERPAPI_API_KEY=your-serpapi-api-key
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAIL=admin@example.com
# Leave QDRANT_URL empty for fast embedded local storage (./qdrant_data)
QDRANT_URL=
QDRANT_PATH=./qdrant_data
QDRANT_API_KEY=
QDRANT_COLLECTION=chat_messages
RAG_MIN_MESSAGES=1
FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your@gmail.com
SMTP_FROM_NAME=Iasty
SMTP_USE_SSL=false
# Email provider: auto | gmail | resend | smtp
EMAIL_PROVIDER=gmail
# Gmail API (HTTPS — send from your @gmail.com address)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=Iasty <your@gmail.com>
GMAIL_SENDER=
# Resend (HTTPS — works when SMTP ports 587/465 are blocked): https://resend.com
RESEND_API_KEY=
RESEND_FROM=Iasty <onboarding@resend.dev>
EMAIL_VERIFY_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1
